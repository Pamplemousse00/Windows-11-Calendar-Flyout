<Application
    x:Class="Win10CalendarFlyout.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- The fallback is only visible for the first compositor frame. -->
                    <SolidColorBrush x:Key="FlyoutFallbackBrush" Color="#202020" />
                    <SolidColorBrush x:Key="FlyoutTintBrush" Color="#24000000" />
                    <SolidColorBrush x:Key="FlyoutHeaderTintBrush" Color="#25000000" />
                    <SolidColorBrush x:Key="FlyoutOutOfScopeDayBrush" Color="#70FFFFFF" />
                    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#202020" />
                    <SolidColorBrush x:Key="FlyoutSubtleBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="FlyoutHoverBrush" Color="#14FFFFFF" />
                    <SolidColorBrush x:Key="FlyoutPressedBrush" Color="#20FFFFFF" />
                    <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#1FFFFFFF" />
                    <SolidColorBrush x:Key="FlyoutSecondaryTextBrush" Color="#B8FFFFFF" />
                    <SolidColorBrush x:Key="FlyoutTertiaryTextBrush" Color="#8FFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="FlyoutFallbackBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="FlyoutTintBrush" Color="#10FFFFFF" />
                    <SolidColorBrush x:Key="FlyoutHeaderTintBrush" Color="#0A000000" />
                    <SolidColorBrush x:Key="FlyoutOutOfScopeDayBrush" Color="#68000000" />
                    <SolidColorBrush x:Key="WindowFallbackBrush" Color="#F3F3F3" />
                    <SolidColorBrush x:Key="FlyoutSubtleBrush" Color="#12000000" />
                    <SolidColorBrush x:Key="FlyoutHoverBrush" Color="#0F000000" />
                    <SolidColorBrush x:Key="FlyoutPressedBrush" Color="#18000000" />
                    <SolidColorBrush x:Key="FlyoutStrokeBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="FlyoutSecondaryTextBrush" Color="#B8000000" />
                    <SolidColorBrush x:Key="FlyoutTertiaryTextBrush" Color="#82000000" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
