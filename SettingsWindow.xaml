<Window
    x:Class="Win10CalendarFlyout.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="SettingsRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Padding="14,0,140,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE713;" FontSize="15" />
                <TextBlock Text="Calendar Flyout settings" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1"
                      VerticalScrollMode="Enabled"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      IsVerticalRailEnabled="True"
                      UseLayoutRounding="True">
            <StackPanel x:Name="SettingsContentPanel" Padding="24,18,24,26" Spacing="18">
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

                <Border Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Behavior" FontSize="15" FontWeight="SemiBold" />
                        <ToggleSwitch x:Name="SwitchToTodayToggle"
                                      Header="Switch to current date when flyout is opened"
                                      Toggled="SwitchToTodayToggle_Toggled" />
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Calendar appearance" FontSize="15" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Maximum event dots" />
                                <TextBlock Text="Show up to 0–4 event dots under each day."
                                           FontSize="12"
                                           Opacity="0.65" />
                            </StackPanel>
                            <ComboBox x:Name="MaxDotsComboBox"
                                      Grid.Column="1"
                                      Width="76"
                                      HorizontalAlignment="Right"
                                      SelectionChanged="MaxDotsComboBox_SelectionChanged">
                                <ComboBoxItem Content="0" />
                                <ComboBoxItem Content="1" />
                                <ComboBoxItem Content="2" />
                                <ComboBoxItem Content="3" />
                                <ComboBoxItem Content="4" />
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Calendar colors" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Override the color used for agenda bars and event dots."
                                       FontSize="12"
                                       Opacity="0.65" />
                        </StackPanel>
                        <StackPanel x:Name="CalendarColorRows" Spacing="8" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing x:Name="CalendarColorLoadingRing"
                                          Width="16"
                                          Height="16"
                                          IsActive="False"
                                          Visibility="Collapsed" />
                            <TextBlock x:Name="CalendarColorEmptyText"
                                       Text="Sign in to Google Calendar to customize calendar colors."
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Background activity" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="Control the periodic checks Calendar Flyout performs. Turning these off can reduce background work, but may disable the related feature."
                                       FontSize="12"
                                       Opacity="0.65"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid ColumnSpacing="12" Padding="4,2,4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Task" FontSize="11" Opacity="0.62" />
                            <TextBlock Grid.Column="1" Text="How often" FontSize="11" Opacity="0.62" />
                            <TextBlock Grid.Column="2" Text="While closed" FontSize="11" Opacity="0.62" />
                            <TextBlock Grid.Column="3" Text="State" FontSize="11" Opacity="0.62" HorizontalAlignment="Center" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.6" />

                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Google Calendar auto-refresh" />
                                <TextBlock Text="Off: new or changed events appear only after manual refresh or an uncached month load."
                                           FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Every 5 min" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Yes" FontSize="12" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="GoogleAutoRefreshToggle"
                                          Grid.Column="3"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="GoogleAutoRefreshToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.35" />

                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Event reminder check" />
                                <TextBlock Text="Off: Windows reminder notifications from Google Calendar will not be shown."
                                           FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Every 15 sec*" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Yes*" FontSize="12" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ReminderChecksToggle"
                                          Grid.Column="3"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ReminderChecksToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.35" />

                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Tray date icon update" />
                                <TextBlock Text="Off: the day number in the tray icon may remain stale after midnight until restart."
                                           FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Every 1 min" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Yes" FontSize="12" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="TrayDateIconToggle"
                                          Grid.Column="3"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="TrayDateIconToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.35" />

                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Current-event and midnight UI update" />
                                <TextBlock Text="Off: the current-event marker and live midnight rollover will not update while the flyout stays open."
                                           FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Every 1 min" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="No" FontSize="12" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="CurrentEventUpdatesToggle"
                                          Grid.Column="3"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="CurrentEventUpdatesToggle_Toggled" />
                        </Grid>

                        <Border Height="1" Background="{ThemeResource CardStrokeColorDefaultBrush}" Opacity="0.35" />

                        <Grid ColumnSpacing="12" Padding="4,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3.2*" />
                                <ColumnDefinition Width="1.25*" />
                                <ColumnDefinition Width="1.05*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Click-away dismissal check" />
                                <TextBlock Text="Off: clicking another app will not automatically close the flyout; use the tray icon to close it."
                                           FontSize="11" Opacity="0.58" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="Every 100 ms" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="No" FontSize="12" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="ClickAwayDismissToggle"
                                          Grid.Column="3"
                                          MinWidth="0"
                                          OnContent=""
                                          OffContent=""
                                          VerticalAlignment="Center"
                                          Toggled="ClickAwayDismissToggle_Toggled" />
                        </Grid>

                        <TextBlock Text="* The reminder timer runs only when at least one popup reminder is pending."
                                   FontSize="11"
                                   Opacity="0.58"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Padding="16"
                        CornerRadius="8"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="About Calendar Flyout" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Calendar Flyout" />
                        <TextBlock x:Name="VersionText" Text="Version 0.39.0" FontSize="12" Opacity="0.68" />
                        <TextBlock Text="Made by Neeraj Ahluwalia" FontSize="12" Opacity="0.68" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
