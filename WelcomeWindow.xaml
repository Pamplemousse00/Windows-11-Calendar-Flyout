<Window
    x:Class="Win10CalendarFlyout.WelcomeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="WelcomeRoot" Background="{ThemeResource WindowFallbackBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom title bar: this keeps the top strip in the same dark/Mica material
             as the rest of the WinUI window instead of using the white legacy caption. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="40"
              Padding="14,0,140,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">
                <FontIcon Glyph="&#xE787;" FontSize="15" />
                <TextBlock Text="Calendar Flyout"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1"
              Padding="30,18,30,26"
              RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="6">
                <TextBlock Text="Welcome to Calendar Flyout"
                           FontSize="24"
                           FontWeight="SemiBold" />
                <TextBlock Text="A Windows 11-style calendar and Google Calendar agenda for your notification area."
                           FontSize="14"
                           Opacity="0.72"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1"
                    Padding="16"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="7">
                    <TextBlock Text="Pin the tray icon"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Windows may initially place the calendar icon in the hidden-icons overflow. Open the ^ menu and drag the calendar icon into the notification area beside Wi-Fi, volume, and the clock."
                               FontSize="13"
                               Opacity="0.78"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <CheckBox x:Name="StartupCheckBox"
                      Grid.Row="2"
                      IsChecked="True"
                      Content="Add to startup apps" />

            <TextBlock Grid.Row="3"
                       Text="You can change Startup Apps later in Windows Settings. Google Calendar sign-in is available from the flyout after setup."
                       FontSize="12"
                       Opacity="0.62"
                       TextWrapping="Wrap"
                       VerticalAlignment="Top" />

            <Button Grid.Row="4"
                    HorizontalAlignment="Right"
                    MinWidth="96"
                    Height="34"
                    Content="Ok, got it."
                    Style="{StaticResource AccentButtonStyle}"
                    Click="ProceedButton_Click" />
        </Grid>
    </Grid>
</Window>
