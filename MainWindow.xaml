<Window
    x:Class="Win10CalendarFlyout.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The HWND owns the Desktop Acrylic backdrop. The fixed full-size XAML surface
        stays composed while the actual window slides into and out of the taskbar.
    -->
    <Grid Background="Transparent">
        <!-- The flyout is always shown at its full calendar + agenda size. -->
        <Grid x:Name="RootSurface"
              Height="720"
              VerticalAlignment="Top"
              Background="Transparent">
            <Grid VerticalAlignment="Stretch"
                  HorizontalAlignment="Stretch"
                  Background="Transparent">

            <!-- The desktop Acrylic is attached to the Window itself. Because the HWND
                 is what moves during the flyout animation, the material now moves with
                 the panel instead of appearing after the motion has finished. -->
            <Border Background="{ThemeResource FlyoutTintBrush}"
                    CornerRadius="10"
                    IsHitTestVisible="False" />

            <Grid>
                <Grid Height="50"
                      VerticalAlignment="Top"
                      Padding="18,0,10,0"
                      Background="{ThemeResource FlyoutHeaderTintBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderDateText"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Normal" />

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Button x:Name="RefreshButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="{ThemeResource FlyoutSubtleBrush}"
                                BorderBrush="{ThemeResource FlyoutStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Click="RefreshButton_Click"
                                ToolTipService.ToolTip="Refresh Google Calendar">
                            <FontIcon Glyph="&#xE72C;" FontSize="13" />
                        </Button>
                        <Button x:Name="SettingsButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Background="{ThemeResource FlyoutSubtleBrush}"
                                BorderBrush="{ThemeResource FlyoutStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Click="SettingsButton_Click"
                                ToolTipService.ToolTip="Settings">
                            <FontIcon Glyph="&#xE713;" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Height="1"
                        Margin="0,50,0,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource FlyoutStrokeBrush}" />

                <Grid Height="390"
                      Margin="0,51,0,0"
                      VerticalAlignment="Top"
                      Opacity="1">
                    <CalendarView x:Name="MonthCalendar"
                                  Margin="8,8,8,5"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  SelectionMode="Single"
                                  IsTodayHighlighted="False"
                                  IsOutOfScopeEnabled="True"
                                  DayItemFontSize="14"
                                  DayItemFontWeight="Normal"
                                  HorizontalDayItemAlignment="Center"
                                  VerticalDayItemAlignment="Center"
                                  UseLayoutRounding="True"
                                  DayOfWeekFormat="{}{dayofweek.abbreviated(2)}"
                                  CalendarItemHoverBackground="Transparent"
                                  CalendarItemPressedBackground="Transparent"
                                  CalendarItemBorderBrush="Transparent"
                                  CalendarItemBorderThickness="0"
                                  SelectedBorderBrush="Transparent"
                                  SelectedHoverBorderBrush="Transparent"
                                  SelectedPressedBorderBrush="Transparent"
                                  CalendarViewDayItemChanging="MonthCalendar_CalendarViewDayItemChanging"
                                  SelectedDatesChanged="MonthCalendar_SelectedDatesChanged"
                                  LayoutUpdated="MonthCalendar_LayoutUpdated">
                        <CalendarView.CalendarViewDayItemStyle>
                            <Style TargetType="CalendarViewDayItem">
                                <Setter Property="MinWidth" Value="44" />
                                <Setter Property="MinHeight" Value="56" />
                                <Setter Property="Margin" Value="1" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="CalendarViewDayItem">
                                            <ContentControl Content="{TemplateBinding Tag}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            IsHitTestVisible="False">
                                                <ContentControl.ContentTemplate>
                                                    <DataTemplate>
                                                        <Grid Width="44"
                                                              Height="56"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              UseLayoutRounding="True">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="44" />
                                                                <RowDefinition Height="12" />
                                                            </Grid.RowDefinitions>

                                                            <Grid Grid.Row="0"
                                                                  Width="44"
                                                                  Height="44"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center">
                                                                <Ellipse Width="44" Height="44"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{Binding HoverFill}" />
                                                                <Ellipse Width="36" Height="36"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Fill="{Binding TodayFill}" />
                                                                <Ellipse Width="44" Height="44"
                                                                         HorizontalAlignment="Center"
                                                                         VerticalAlignment="Center"
                                                                         Fill="Transparent"
                                                                         Stroke="{Binding SelectionStroke}"
                                                                         StrokeThickness="{Binding SelectionStrokeThickness}" />
                                                                <TextBlock Text="{Binding DayText}"
                                                                           Foreground="{Binding DayForeground}"
                                                                           FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                                                                           FontSize="14"
                                                                           FontWeight="Normal"
                                                                           TextAlignment="Center"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>

                                                            <StackPanel Grid.Row="1"
                                                                        Orientation="Horizontal"
                                                                        Spacing="2"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        IsHitTestVisible="False"
                                                                        UseLayoutRounding="True">
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Dot1}" Visibility="{Binding Dot1Visibility}" />
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Dot2}" Visibility="{Binding Dot2Visibility}" />
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Dot3}" Visibility="{Binding Dot3Visibility}" />
                                                                <Ellipse Width="5" Height="5" Fill="{Binding Dot4}" Visibility="{Binding Dot4Visibility}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ContentControl.ContentTemplate>
                                            </ContentControl>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </CalendarView.CalendarViewDayItemStyle>
                    </CalendarView>
                </Grid>

                <Border Height="1"
                        Margin="0,441,0,0"
                        VerticalAlignment="Top"
                        Background="{ThemeResource FlyoutStrokeBrush}" />

                <Grid Height="278"
                      Margin="0,442,0,0"
                      VerticalAlignment="Top"
                      Padding="16,13,12,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,4,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="1">
                            <TextBlock Text="Agenda"
                                       FontSize="19"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="AgendaDateText"
                                       FontSize="12"
                                       Foreground="{ThemeResource FlyoutSecondaryTextBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    VerticalAlignment="Center">
                            <Button x:Name="PreviousAgendaDayButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Background="{ThemeResource FlyoutSubtleBrush}"
                                    BorderBrush="{ThemeResource FlyoutStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Click="PreviousAgendaDayButton_Click"
                                    ToolTipService.ToolTip="Previous day">
                                <FontIcon Glyph="&#xE76B;" FontSize="12" />
                            </Button>
                            <Button x:Name="NextAgendaDayButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Background="{ThemeResource FlyoutSubtleBrush}"
                                    BorderBrush="{ThemeResource FlyoutStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Click="NextAgendaDayButton_Click"
                                    ToolTipService.ToolTip="Next day">
                                <FontIcon Glyph="&#xE76C;" FontSize="12" />
                            </Button>
                            <Button x:Name="AddEventButton"
                                    Width="30"
                                    Height="30"
                                    Padding="0"
                                    Background="{ThemeResource FlyoutSubtleBrush}"
                                    BorderBrush="{ThemeResource FlyoutStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Click="AddEventButton_Click"
                                    ToolTipService.ToolTip="New Google Calendar event">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="AgendaContentHost" Grid.Row="1" MinHeight="110" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="AgendaTranslateTransform" />
                        </Grid.RenderTransform>
                        <ListView x:Name="AgendaList"
                                  ItemsSource="{x:Bind AgendaItems}"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  IsItemClickEnabled="True"
                                  SelectionMode="None"
                                  ScrollViewer.VerticalScrollMode="Enabled"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.IsVerticalRailEnabled="True"
                                  ItemClick="AgendaList_ItemClick">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1,3,1" />
                                    <Setter Property="MinHeight" Value="50" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,6" MinHeight="50">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Small now-marker to the left of the calendar-color bar. -->
                                        <Ellipse Width="5"
                                                 Height="5"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Center"
                                                 Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                 Visibility="{Binding NowIndicatorVisibility}" />

                                        <Border Grid.Column="1"
                                                Background="{Binding CalendarBrush}"
                                                CornerRadius="2" />

                                        <StackPanel Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    Spacing="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CalendarName}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource FlyoutTertiaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="4"
                                                   Margin="12,0,2,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding TimeText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource FlyoutSecondaryTextBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel x:Name="EmptyAgendaPanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="4"
                                    Visibility="Collapsed">
                            <FontIcon Glyph="&#xE787;"
                                      FontSize="20"
                                      Foreground="{ThemeResource FlyoutTertiaryTextBrush}" />
                            <TextBlock Text="Nothing scheduled"
                                       Foreground="{ThemeResource FlyoutSecondaryTextBrush}" />
                        </StackPanel>

                        <ProgressRing x:Name="LoadingRing"
                                      Canvas.ZIndex="20"
                                      Width="32"
                                      Height="32"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      IsActive="False"
                                      Visibility="Collapsed" />

                        <Button x:Name="SignInButton"
                                MinHeight="34"
                                Padding="16,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{ThemeResource FlyoutSubtleBrush}"
                                BorderBrush="{ThemeResource FlyoutStrokeBrush}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Click="SignInButton_Click"
                                Content="Sign in to Google" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="2,7,4,0">
                        <TextBlock x:Name="StatusText"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="{ThemeResource FlyoutTertiaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</Window>
